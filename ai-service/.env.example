# Copy to ai-service/.env (never commit .env).
# Free Gemini key: https://aistudio.google.com/apikey  (empty = AI writing features are off)
LLM_API_KEY=
# Optional: other OpenAI-compatible providers, e.g. Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# Only when deployed: same secret as the backend's AI_SERVICE_TOKEN
# AI_SERVICE_TOKEN=
